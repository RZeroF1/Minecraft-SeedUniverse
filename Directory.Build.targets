<Project>
  <PropertyGroup>
    <SeedMapNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</SeedMapNativeRid>
    <SeedMapNativeRid Condition="'$(SeedMapNativeRid)' == ''">win-x64</SeedMapNativeRid>
    <SeedMapNativeArchitecture Condition="'$(SeedMapNativeRid)' == 'win-x64'">x64</SeedMapNativeArchitecture>
  </PropertyGroup>
</Project>
